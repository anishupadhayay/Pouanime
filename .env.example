# Template only. Never put real credentials in this file or commit a .env file.
# Local development uses SQLite; use your Turso URL only in your private .env/Vercel settings.
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=

# Generate a private random value of at least 32 characters.
JWT_SECRET=

# Set these privately before running db:seed. Admin password must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional; the app currently uses same-origin relative API requests.
FRONTEND_URL=http://localhost:3000
# AniList's public GraphQL API does not require an API key.
